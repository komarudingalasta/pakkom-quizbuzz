{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null",
        "hostUid": {
          ".validate": "newData.isString() && (!data.exists() ? newData.val() === auth.uid : newData.val() === data.val())"
        },
        "maxTeams": { ".validate": "newData.isNumber() && newData.val() >= 2 && newData.val() <= 50" },
        "locked": { ".validate": "newData.isBoolean()" },
        "status": { ".validate": "!newData.exists() || newData.val() === 'lobby' || newData.val() === 'playing' || newData.val() === 'finished'" },
        "teams": {
          "$teamId": {
            "ownerUid": {
              ".validate": "newData.isString() && (!data.exists() ? newData.val() === auth.uid : newData.val() === data.val())"
            },
            "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 30" },
            "score": { ".validate": "newData.isNumber()" },
            "avatarPhoto": {
              ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 70000 && (newData.val().beginsWith('data:image/jpeg;base64,') || newData.val().beginsWith('data:image/webp;base64,') || newData.val().beginsWith('data:image/png;base64,')))"
            }
          }
        }
      }
    }
  }
}